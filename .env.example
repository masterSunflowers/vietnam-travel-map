# Docker Compose defaults
TRAVEL_VIEW_POSTGRES_USER=postgres
TRAVEL_VIEW_POSTGRES_PASSWORD=postgres
TRAVEL_VIEW_POSTGRES_DB=travel_view
# Host port mapping for PostgreSQL. Đổi thành cổng khác (ví dụ: 5433 hoặc 54322) nếu cổng 5432 trên máy đã bị chiếm.
TRAVEL_VIEW_POSTGRES_PORT=5432

# Host port mapping for Redis. Đổi thành cổng khác (ví dụ: 6380) nếu cổng 6379 trên máy đã bị chiếm.
TRAVEL_VIEW_REDIS_PORT=6379

# Backend local overrides, if running outside Docker
# Lưu ý: Nếu đổi TRAVEL_VIEW_POSTGRES_PORT ở trên, hãy cập nhật cổng tương ứng trong DATABASE_URL dưới đây.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/travel_view
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public build-time values
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key
